<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="sale_order_portal_template"
        inherit_id="sale.sale_order_portal_template"
        priority="99"
    >
        <xpath
            expr="//div[@id='sale_order_sidebar_button']/div[hasclass('o_download_pdf')]"
            position="before"
        >
            <a
                t-if="not sale_order._check_partner_mandatory_fields(sale_order.partner_id)
                and (
                    (sale_order._has_to_be_signed() and not payment_amount)
                    or sale_order._has_to_be_paid()
                    or (
                        payment_amount
                        and sale_order.amount_paid &lt; sale_order.amount_total
                        and sale_order.state != 'cancel'
                    )
                )"
                class="btn btn-primary d-block"
                role="button"
                t-att-href="'/my/account?order_id=%s&amp;redirect=%s' % (sale_order.id, sale_order.get_portal_url())"
            >
                <i class="fa fa-check" />
                <t t-if="sale_order._has_to_be_signed()">
                    <t t-if="sale_order._has_to_be_paid()"> Sign &amp; Pay</t>
                    <t t-else=""> Accept &amp; Sign</t>
                </t>
                <t t-elif="sale_order._has_to_be_paid()">
                    <t t-if="not sale_order.signature"> Accept &amp; Pay</t>
                    <t t-else=""> Pay Now</t>
                </t>
            </a>
        </xpath>
        <xpath
            expr="//div[@id='sale_order_sidebar_button']/a[@data-bs-target='#modalaccept']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >sale_order._has_to_be_signed() and not payment_amount and sale_order._check_partner_mandatory_fields(sale_order.partner_id)</attribute>
        </xpath>
        <xpath
            expr="//div[@id='sale_order_sidebar_button']/a[@id='o_sale_portal_paynow']"
            position="attributes"
        >
            <attribute name="t-elif">
                (
                    sale_order._has_to_be_paid()
                    or (
                        payment_amount
                        and sale_order.amount_paid &lt; sale_order.amount_total
                        and sale_order.state != 'cancel'
                    )
                )
                and sale_order._check_partner_mandatory_fields(sale_order.partner_id)
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-if='sale_order._has_to_be_signed()']/a[@data-bs-target='#modalaccept']"
            position="attributes"
        >
            <attribute name="t-if">
                sale_order._check_partner_mandatory_fields(sale_order.partner_id)
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-if='sale_order._has_to_be_signed()']/a[@data-bs-target='#modalaccept']"
            position="after"
        >
            <a
                t-else=""
                class="btn btn-primary btn-lg"
                role="button"
                t-att-href="'/my/account?order_id=%s&amp;redirect=%s' % (
                    sale_order.id, sale_order.get_portal_url()
                )"
            >
                <i class="oi" data-icon="check" />
                <t t-if="sale_order._has_to_be_paid()">Sign &amp; Pay</t>
                <t t-else="">Accept &amp; Sign</t>
            </a>
        </xpath>
        <xpath
            expr="//t[@t-elif='sale_order._has_to_be_paid()']/a[@data-bs-target='#modalaccept']"
            position="attributes"
        >
            <attribute name="t-if">
                sale_order._check_partner_mandatory_fields(sale_order.partner_id)
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-elif='sale_order._has_to_be_paid()']/a[@data-bs-target='#modalaccept']"
            position="after"
        >
            <a
                t-else=""
                class="btn btn-primary btn-lg rounded"
                role="button"
                t-att-href="'/my/account?order_id=%s&amp;redirect=%s' % (
                    sale_order.id, sale_order.get_portal_url()
                )"
            >
                <t t-if="not sale_order.signature">Accept &amp; Pay</t>
                <t t-else="">Pay Now</t>
            </a>
        </xpath>
        <!-- Mobile sticky action bar (new in 20.0) -->
        <xpath
            expr="//div[hasclass('o_portal_mobile_action_buttons')]/a[@t-if='mobile_has_to_be_signed'][@data-bs-target='#modalaccept']"
            position="attributes"
        >
            <attribute name="t-if">
                mobile_has_to_be_signed
                and sale_order._check_partner_mandatory_fields(sale_order.partner_id)
            </attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('o_portal_mobile_action_buttons')]/a[@id='o_sale_portal_paynow_mobile']"
            position="before"
        >
            <a
                t-elif="(mobile_has_to_be_signed or mobile_has_to_be_paid)
                    and not sale_order._check_partner_mandatory_fields(sale_order.partner_id)"
                class="btn btn-primary flex-grow-1"
                role="button"
                t-att-href="'/my/account?order_id=%s&amp;redirect=%s' % (
                    sale_order.id, sale_order.get_portal_url()
                )"
            >
                <t t-if="mobile_has_to_be_signed">
                    <t t-if="sale_order._has_to_be_paid()">Sign &amp; Pay</t>
                    <t t-else="">Accept &amp; Sign</t>
                </t>
                <t t-elif="not sale_order.signature">Accept &amp; Pay</t>
                <t t-else="">Pay Now</t>
            </a>
        </xpath>
    </template>
</odoo>
