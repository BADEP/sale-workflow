<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_pricelist_item_form" model="ir.ui.view">
        <field name="name">view.product.pricelist.item.form</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='pricelist_rule_target']/field[@name='product_id']"
                position="after"
            >
                <field
                    name="global_categ_id"
                    options="{'no_create':1}"
                    invisible="categ_id or product_tmpl_id or global_product_tmpl_id"
                />
                <field
                    name="global_product_tmpl_id"
                    string="Global Product"
                    options="{'no_create':1}"
                    invisible="categ_id or product_tmpl_id or global_categ_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
